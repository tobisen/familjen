VITE_BASE_PATH=/familjen/
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Only a public publishable/anon key. Never service_role or secret keys.

# Optional: isolated app shell without the configured Familjen backend
VITE_SUPABASE_DISABLED=false

# Public VAPID key lives in config/public-push.json.
# VAPID_PRIVATE_KEY and PUSH_WORKER_SECRET belong ONLY in Supabase Edge Secrets.
